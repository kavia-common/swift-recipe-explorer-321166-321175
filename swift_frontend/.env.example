# Swift toolchain installation (only needed if swift is not already available in the environment)
# Provide ONE of the following:
SWIFT_VERSION=
SWIFT_URL=
# Optional checksum verification for SWIFT_URL/SWIFT_VERSION download:
SWIFT_SHA256=

# Optional: build WebAssembly with SwiftWasm carton (not required for this task)
BUILD_WASM=0
CARTON_URL=
CARTON_SHA256=
